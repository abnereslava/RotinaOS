rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingDocument() {
      return signedIn()
        && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /activities/{activityId} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsIncomingDocument();

      allow update: if ownsExistingDocument()
                    && ownsIncomingDocument();
    }

    match /activity_occurrences/{occurrenceId} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsIncomingDocument();

      allow update: if ownsExistingDocument()
                    && ownsIncomingDocument();
    }

    match /weekly_checklists/{userId} {
      // A leitura pelo UID também permite consultar a primeira semana,
      // antes de o documento existir, para criá-lo na transação.
      allow read: if signedIn() && userId == request.auth.uid;
      allow create: if ownsIncomingDocument() && userId == request.auth.uid;
      allow delete: if ownsExistingDocument() && userId == request.auth.uid;
      allow update: if ownsExistingDocument()
                    && ownsIncomingDocument()
                    && userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
